{
  "info": {
    "name": "06 — Phase 3.4 Student Materials",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Student cookie auth: My Classes FULL -> class detail units[].id -> visible ARTICLE/FILE/VIDEO list -> detail (ARTICLE contentHtml + inlineImages/attachments metadata) -> short-lived signed GET. FILE/VIDEO primary: GET download. Any referenced file (primary, ARTICLE inline image via data-file-id, attachment): POST files/{{file_id}}/access with Origin + body {}. Requires approved/published Material and released unit. Never send BE cookies to storage or persist signed URLs."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "student_email",
      "value": ""
    },
    {
      "key": "student_password",
      "value": ""
    },
    {
      "key": "class_id",
      "value": ""
    },
    {
      "key": "class_unit_id",
      "value": ""
    },
    {
      "key": "material_id",
      "value": ""
    },
    {
      "key": "origin",
      "value": "http://localhost:3001"
    },
    {
      "key": "file_id",
      "value": ""
    },
    {
      "key": "revision",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Login Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}"
        }
      }
    },
    {
      "name": "My Classes — choose FULL class_id",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes?page=1&pageSize=20"
      }
    },
    {
      "name": "Class detail — choose units[].id as class_unit_id",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}"
      }
    },
    {
      "name": "Visible materials — choose item.id as material_id",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/units/{{class_unit_id}}/materials?page=1&pageSize=20"
      }
    },
    {
      "name": "Material detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/materials/{{material_id}}"
      }
    },
    {
      "name": "Authorize download — use URL directly without API cookies",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/materials/{{material_id}}/download"
      }
    },
    {
      "name": "Referenced file access — inline image/attachment/primary signed URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/materials/{{material_id}}/files/{{file_id}}/access",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Inline image/attachment GET access at expected revision",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/materials/{{material_id}}/assets/{{file_id}}/access?expectedRevision={{revision}}"
      }
    }
  ]
}
