      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              " const rows = pm.response.json().items;",
              " const selected = rows.find(row => row.id === pm.collectionVariables.get('class_unit_id')) || rows[0];",
              " if (selected) {",
              "  pm.collectionVariables.set('class_unit_id', selected.id);",
              "  pm.collectionVariables.set('course_unit_id', selected.courseUnitId);",
              " }",
              "}"
            ]
          }
        }
      ]
