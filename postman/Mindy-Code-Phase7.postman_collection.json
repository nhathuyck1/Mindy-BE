          }
        ],
        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}/code-runs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"languageKey\": \"javascript\",\n  \"sourceCode\": \"function twoSum(nums, target) {\\n  return [0, 1];\\n}\"\n}"
        }
      },
      "description": "Not stored; rate limited (CODE_RUN_PER_MINUTE/DAY)."
    },
    {
      "name": "Student run custom input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}/code-runs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"languageKey\": \"javascript\",\n  \"sourceCode\": \"function twoSum(nums, target) {\\n  return [0, 1];\\n}\",\n  \"customArgs\": [\n    [\n      1,\n      4\n    ],\n    5\n  ]\n}"
        }
      },
      "description": ""
    },
    {
      "name": "Student submit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}/code-submissions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"languageKey\": \"javascript\",\n  \"sourceCode\": \"function twoSum(nums, target) {\\n  return [0, 1];\\n}\"\n}"
        }
      },
      "description": "202 created / 200 replay with the same key. Copy id → submission_id."
    },
    {
      "name": "Student submission detail (poll)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/me/code-submissions/{{submission_id}}"
      },
      "description": "Poll every retryAfterMs while QUEUED/RUNNING."
    },
