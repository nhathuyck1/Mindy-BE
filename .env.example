# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# PostgreSQL
DATABASE_URL=postgresql://mindy:mindy@localhost:5433/mindy_center
DATABASE_LOGGING=false

# Cookie authentication (implemented in the auth milestone)
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# JWT RS256 keys must be supplied as secrets outside source control.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Google OIDC (web application OAuth client)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
REGISTRATION_INTENT_TTL_SECONDS=900
FRONTEND_BASE_URL=http://localhost:3001
GOOGLE_REGISTRATION_PATH=/register/complete
GOOGLE_AUTH_SUCCESS_PATH=/
GOOGLE_AUTH_ERROR_PATH=/login

# Verification email (local defaults target Mailpit from compose.yaml)
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mindy Center <no-reply@mindy.local>
EMAIL_VERIFICATION_TTL_SECONDS=1800
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_PATH=/verify-email
# Frontend route used by the payment email; :orderId is replaced with the order UUID.
ORDER_DETAILS_PATH=/orders/:orderId

# Classes and checkout (all optional; values shown are the defaults)
# IANA time zone of the center; class start/end dates are calendar dates in this zone.
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# Seat hold per pending order, in seconds: 15 minutes for PayOS, 48 hours for cash.
ORDER_PAYOS_HOLD_TTL_SECONDS=900
# Payment SDK disabled by default; stopping new links must not disable callbacks.
PAYOS_ENABLED=false
PAYOS_CREATE_LINK_ENABLED=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3001/payment/result
PAYOS_CANCEL_URL=http://localhost:3001/payment/result
PAYOS_WEBHOOK_URL=
PAYMENT_MAIL_JOB_ENABLED=true
PAYMENT_MAIL_JOB_INTERVAL_SECONDS=30
ORDER_CASH_HOLD_TTL_SECONDS=172800
# Background job that expires unpaid orders and releases their seats.
ORDER_EXPIRY_JOB_ENABLED=true
ORDER_EXPIRY_JOB_INTERVAL_SECONDS=60

# One-off development/bootstrap seed values; keep empty during normal app startup.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_DISPLAY_NAME=admin
SEED_ADMIN_CONFIRM=123456
# Demo seeds, run in this order: pnpm seed:account, then pnpm seed:course-class.
# Password of every account created by pnpm seed:account (mentors, students).
# In production the demo seeds also require SEED_DEMO_CONFIRM=YES.
SEED_ACCOUNT_PASSWORD=change-me-account-password

# Optional infrastructure; modules initialize only when explicitly enabled.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mindy-center

# Browser-reachable signer origin (empty = internal endpoint); no path/query rewriting.
MINIO_PUBLIC_URL=
# PUT TTL 30..600s; intent TTL 600..3600s. Actor quota includes PROCESSING uploads.
FILE_PUT_TTL_SECONDS=600
FILE_INTENT_TTL_SECONDS=1800
FILE_MAX_OPEN_INTENTS=20
# Durable PostgreSQL VALIDATE worker; EXTRACT/PURGE handlers arrive in Phase 3.5.
FILE_JOB_ENABLED=true
FILE_JOB_POLL_SECONDS=5
FILE_JOB_CONCURRENCY=2
FILE_JOB_LEASE_SECONDS=300
FILE_JOB_HEARTBEAT_SECONDS=30
FILE_JOB_MAX_ATTEMPTS=5
FILE_JOB_TIMEOUT_SECONDS=180
FILE_VALIDATION_TIMEOUT_SECONDS=60
# Optional absolute worker scratch path; omit for OS temp/mindy-file-validation.
# FILE_SCRATCH_DIRECTORY=
