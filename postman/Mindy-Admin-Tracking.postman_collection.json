{
  "info": {
    "name": "Admin — Consolidated tracking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires migration 1792627200002. Read-only ADMIN audit history; receipts are never returned. See docs/api_flow/ADMIN_TRACKING.md. Cookie auth; no auto mutation runner."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "event_source",
      "value": "session_meeting_audits"
    },
    {
      "key": "event_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:3001"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Latest events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/tracking/events?page=1&pageSize=20",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "tracking", "events"]
        }
      }
    },
    {
      "name": "Filter by source",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/tracking/events?source={{event_source}}&page=1&pageSize=20",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "tracking", "events"]
        }
      }
    },
    {
      "name": "Original event details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/tracking/events/{{event_source}}/{{event_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "tracking", "events", "{{event_source}}", "{{event_id}}"]
        }
      }
    }
  ]
}
