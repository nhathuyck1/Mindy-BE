{
  "info": {
    "name": "Phase 5 — Assignment QUIZ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Implemented QUIZ slice; ZIP/reporting pending. Manual requests only. Use existing auth cookie jar. Set IDs and latest revisions/versions before mutations. Set idempotency_key to an explicit UUIDv4; exact network retries reuse key/body. Switch mentor/student login for the appropriate routes. Local verification only."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "origin", "value": "http://localhost:3001" },
    { "key": "class_id", "value": "" },
    { "key": "session_id", "value": "" },
    { "key": "assignment_id", "value": "" },
    { "key": "submission_id", "value": "" },
    { "key": "question_id_1", "value": "" },
    { "key": "question_id_2", "value": "" },
    { "key": "idempotency_key", "value": "" }
  ],
  "item": [
    {
      "name": "Mentor create quiz draft",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/class-sessions/{{session_id}}/assignments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purpose\": \"TEST\",\n  \"type\": \"QUIZ\",\n  \"title\": \"ABCD quiz\",\n  \"maxScore\": \"100.00\",\n  \"timeLimitMinutes\": 30\n}"
        },
        "description": "MENTOR. Copy id/revision. No creation receipt: reload list before repeating an uncertain create."
      }
    },
    {
      "name": "Mentor list session assignments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/mentor/class-sessions/{{session_id}}/assignments?page=1&pageSize=20"
      }
    },
    {
      "name": "Mentor list class assignments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/mentor/classes/{{class_id}}/assignments?page=1&pageSize=20"
      }
    },
    {
      "name": "Mentor private authoring detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}",
        "description": "Contains private answer keys. Do not share/cache this response for students."
      }
    },
    {
      "name": "Mentor edit draft",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedRevision\": 1,\n  \"title\": \"Updated draft\"\n}"
        },
        "description": "Optional step; refresh expectedRevision in subsequent requests if used. Published edits are rejected."
      }
    },
    {
      "name": "Mentor replace two-question draft",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}/questions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedRevision\": 1,\n  \"questions\": [\n    { \"prompt\": \"Question one\", \"correctOption\": \"A\", \"options\": [{\"label\":\"A\",\"text\":\"One\"},{\"label\":\"B\",\"text\":\"Two\"},{\"label\":\"C\",\"text\":\"Three\"},{\"label\":\"D\",\"text\":\"Four\"}] },\n    { \"prompt\": \"Question two\", \"correctOption\": \"A\", \"options\": [{\"label\":\"A\",\"text\":\"One\"},{\"label\":\"B\",\"text\":\"Two\"},{\"label\":\"C\",\"text\":\"Three\"},{\"label\":\"D\",\"text\":\"Four\"}] }\n  ]\n}"
        },
        "description": "1..200 questions within64KiB. Copy canonical question IDs and new revision from response."
      }
    },
    {
      "name": "Mentor publish quiz",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}/publish",
        "body": { "mode": "raw", "raw": "{\"expectedRevision\":2}" },
        "description": "Latest revision required. Freezes content. ZIP publication unavailable."
      }
    },
    {
      "name": "Student list published assignments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/classes/{{class_id}}/assignments?page=1&pageSize=20",
        "description": "STUDENT with ACTIVE enrollment."
      }
    },
    {
      "name": "Student instructions before start",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}",
        "description": "Metadata only, no questions or keys."
      }
    },
    {
      "name": "Student start or resume quiz",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}/start",
        "body": { "mode": "raw", "raw": "{\"expectedAssignmentRevision\":3}" },
        "description": "Set UUIDv4 key.201 new or200 resume. Copy attemptId to submission_id and canonical question IDs. Timer cannot reset."
      }
    },
    {
      "name": "Student reload saved attempt",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/assignment-submissions/{{submission_id}}"
      }
    },
    {
      "name": "Student save choices without grading",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "url": "{{base_url}}/api/v1/me/assignment-submissions/{{submission_id}}/answers",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":1,\"answers\":[{\"questionId\":\"{{question_id_1}}\",\"selectedOption\":\"A\"}]}"
        },
        "description": "Full replacement. New logical save needs a new UUID key; exact retries preserve body/key. No correctness returned."
      }
    },
    {
      "name": "Student submit complete paper",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "url": "{{base_url}}/api/v1/me/assignment-submissions/{{submission_id}}/submit",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":2,\"answers\":[{\"questionId\":\"{{question_id_1}}\",\"selectedOption\":\"A\"},{\"questionId\":\"{{question_id_2}}\",\"selectedOption\":\"B\"}]}"
        },
        "description": "Example for two-question draft. All questions required. Immediate score/keys in result. Stop autosaves before submit."
      }
    },
    {
      "name": "Student read committed result",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/me/assignment-submissions/{{submission_id}}/result",
        "description": "Poll only FINALIZING every2s, bounded60s. Result persists through terminal enrollment."
      }
    },
    {
      "name": "Mentor archive published assignment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}/archive",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":3,\"reason\":\"Replace assignment\"}"
        },
        "description": "Explicit manual archive, not part of a default runner. Voids active attempts and keeps graded history."
      }
    },
    {
      "name": "Mentor soft delete draft",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/mentor/assignments/{{assignment_id}}",
        "body": { "mode": "raw", "raw": "{\"expectedRevision\":1}" },
        "description": "Explicit manual discard of a DRAFT only. Published assignments cannot be deleted."
      }
    }
  ]
}
