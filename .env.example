# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# PostgreSQL
DATABASE_URL=postgresql://edtech:edtech@localhost:5432/edtech_center
DATABASE_LOGGING=false

# Cookie authentication (implemented in the auth milestone)
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# JWT RS256 keys must be supplied as secrets outside source control.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Optional infrastructure; modules initialize only when explicitly enabled.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=edtech-center
