
POSTGRES_DB=mindy_center
POSTGRES_USER=mindy
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

API_BIND_ADDRESS=0.0.0.0
API_PORT=3000
IMAGE_TAG=latest

NODE_ENV=production
PORT=3000

CORS_ORIGINS=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com

SWAGGER_ENABLED=true
DATABASE_LOGGING=false
DATABASE_URL=postgresql://mindy:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/mindy_center

COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

JWT_PRIVATE_KEY_BASE64=CHANGE_ME_BASE64_ENCODED_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY_BASE64=CHANGE_ME_BASE64_ENCODED_RSA_PUBLIC_KEY

GOOGLE_AUTH_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

GOOGLE_OAUTH_STATE_TTL_SECONDS=600
REGISTRATION_INTENT_TTL_SECONDS=900

GOOGLE_REGISTRATION_PATH=/register/complete
GOOGLE_AUTH_SUCCESS_PATH=/
GOOGLE_AUTH_ERROR_PATH=/login

MAIL_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mindycoding100@gmail.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM="Mindy Center <mindycoding100@gmail.com>"

EMAIL_VERIFICATION_TTL_SECONDS=1800
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_PATH=/verify-email

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=
SEED_ADMIN_CONFIRM=

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379


MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mindy-center
