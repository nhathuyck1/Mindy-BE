        "url": "{{base_url}}/api/v1/me/assignments/{{assignment_id}}/code-drafts/javascript",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": 0,\n  \"sourceCode\": \"function twoSum(nums, target) {\\n  return [0, 1];\\n}\"\n}"
