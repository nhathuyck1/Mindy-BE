{
  "name": "mindy-center-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:generate": "typeorm-ts-node-esm -d src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert",
    "migration:run:build": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert:build": "typeorm -d dist/database/data-source.js migration:revert",
    "seed:admin": "tsx src/database/seed-admin.ts",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "google-auth-library": "^11.1.0",
    "helmet": "8.3.0",
    "joi": "18.2.9",
    "nodemailer": "^10.0.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.2"
  }
}
