{
  "info": {
    "name": "Phase 6 — Chat / Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase6 backend local. Có5 nhóm test; mỗi nhóm có Login Student, Login Mentor và GET auth/me. Điền student_email/student_password/mentor_email/mentor_password trong Postman environment local. CHỌN MỘT login phù hợp rồi chạy API của nhóm; cookie jar theo host dùng actor đăng nhập gần nhất. Không chạy toàn collection như một kịch bản liên tục (login đổi actor, edit/delete cần cùng author, IDs/keys cần dữ liệu thực). CHAT_ENABLED/keyring/CHAT_JOB_ENABLED cần cấu hình; attachments thêm CHAT_ATTACHMENTS_ENABLED/private versioned MinIO. Giữ client_message_id/idempotency_key cho exact retry. Không lưu JWT/cookie/keyring trong variables, không export password. Xem docs/api_flow/PHASE_6_flow-api-breakdown.md."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "origin",
      "value": "http://localhost:3001"
    },
    {
      "key": "class_id",
      "value": ""
    },
    {
      "key": "conversation_id",
      "value": ""
    },
    {
      "key": "peer_user_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "client_message_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    },
    {
      "key": "file_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "through_sequence",
      "value": "0"
    },
    {
      "key": "student_email",
      "value": "",
      "description": "Tài khoản student của bạn. Điền giá trị local trong Postman environment; không export password."
    },
    {
      "key": "student_password",
      "value": "",
      "description": "Tài khoản student của bạn. Điền giá trị local trong Postman environment; không export password."
    },
    {
      "key": "mentor_email",
      "value": "",
      "description": "Tài khoản mentor của bạn. Điền giá trị local trong Postman environment; không export password."
    },
    {
      "key": "mentor_password",
      "value": "",
      "description": "Tài khoản mentor của bạn. Điền giá trị local trong Postman environment; không export password."
    }
  ],
  "item": [
    {
      "name": "01 — Hội thoại (6.2)",
      "description": "C1–C5: discovery, DM, class chat, detail và members. Mở folder đăng nhập và CHỌN MỘT vai trò trước khi test; đây là collection manual, không chạy cả hai login liên tiếp nếu không muốn đổi actor.",
      "item": [
        {
          "name": "00 — Đăng nhập (chọn một vai trò)",
          "description": "Chỉ chạy Login Student hoặc Login Mentor, rồi kiểm tra tài khoản. Cookie jar dùng chung theo host: login sau cùng quyết định actor cho các request tiếp theo.",
          "item": [
            {
              "name": "Login Student",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                      "pm.test('Đúng vai trò STUDENT', () => { const body = pm.response.json(); pm.expect(body.user.role).to.eql('STUDENT'); pm.expect(body.user.status).to.eql('ACTIVE'); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Origin",
                    "value": "{{origin}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"{{student_email}}\",\r\n  \"password\": \"{{student_password}}\",\r\n  \"deviceName\": \"Postman Phase 6\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{base_url}}/api/v1/auth/login",
                "description": "Đăng nhập STUDENT hiện hữu, đủ quyền conversation/class đang test. Postman tự cập nhật cookie jar; không chép token. Chạy một login theo vai trò muốn test. Login lần sau thay cookie actor của host này."
              }
            },
            {
              "name": "Login Mentor",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                      "pm.test('Đúng vai trò MENTOR', () => { const body = pm.response.json(); pm.expect(body.user.role).to.eql('MENTOR'); pm.expect(body.user.status).to.eql('ACTIVE'); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Origin",
                    "value": "{{origin}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"{{mentor_email}}\",\r\n  \"password\": \"{{mentor_password}}\",\r\n  \"deviceName\": \"Postman Phase 6\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{base_url}}/api/v1/auth/login",
                "description": "Đăng nhập MENTOR hiện hữu, đủ quyền conversation/class đang test. Postman tự cập nhật cookie jar; không chép token. Chạy một login theo vai trò muốn test. Login lần sau thay cookie actor của host này."
              }
            },
            {
              "name": "Kiểm tra tài khoản hiện tại",
              "request": {
                "method": "GET",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Origin",
                    "value": "{{origin}}"
                  }
                ],
                "url": "{{base_url}}/api/v1/auth/me",
                "description": "Trả user.role/user.id để kiểm tra actor đang giữ cookie trước khi chạy API của nhóm."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Current user returns 200', () => pm.response.to.have.status(200));",
                      "pm.test('Chat actor is active Student/Mentor', () => { const body = pm.response.json(); pm.expect(['STUDENT', 'MENTOR']).to.include(body.user.role); pm.expect(body.user.status).to.eql('ACTIVE'); });"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "C1 List conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations?limit=20"
          }
        },
        {
          "name": "C2 Ensure direct",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/direct",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"peerUserId\": \"{{peer_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "C3 Class chat",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/api/v1/classes/{{class_id}}/chat"
          }
        },
        {
          "name": "C4 Conversation detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/{{conversation_id}}"
          }
        },
        {
          "name": "C5 Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/{{conversation_id}}/members?limit=20"
          }
        }
      ]
    },
