{
  "name": "mindy-center-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:http": "pnpm build && vitest run --config vitest.http.config.ts",
    "files:local:up": "docker compose -p mindy-files-test -f compose.files-test.yaml up -d --build",
    "files:local:setup": "node tools/minio/setup-local.mjs",
    "test:files": "vitest run test/integration/phase32-files.spec.ts",
    "payos:confirm": "tsx src/operations/confirm-payos-webhook.ts",
    "test:watch": "vitest",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:generate": "typeorm-ts-node-esm -d src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert",
    "migration:run:build": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert:build": "typeorm -d dist/database/data-source.js migration:revert",
    "seed:admin": "tsx src/database/seed-admin.ts",
    "seed:account": "tsx src/database/seed/account.ts",
    "seed:course-class": "tsx src/database/seed/course-class.ts",
    "seed:course-images": "tsx src/database/seed/course-images.ts",
    "seed:data": "pnpm seed:admin && pnpm seed:account && pnpm seed:course-class && pnpm seed:course-images",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@payos/node": "2.0.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "fast-xml-parser": "5.11.2",
    "ffprobe-static": "3.1.0",
    "google-auth-library": "^11.1.0",
    "helmet": "8.3.0",
    "joi": "18.2.9",
    "nodemailer": "^10.0.12",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "0.3.31",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/ffprobe-static": "2.0.3",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "ffmpeg-static": "5.3.0",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.2",
    "yazl": "3.3.1"
  }
}
